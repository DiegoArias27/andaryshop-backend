# Server
PORT=4000
NODE_ENV=development
# CORS allow-list. Comma-separate multiple origins if needed (e.g. staging + prod).
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=andary_shop

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CUSTOMER_JWT_EXPIRES_IN=30d

# Google Sign-In (customer login). Create an OAuth 2.0 Client ID (Web
# application) in Google Cloud Console and add both the frontend origin and
# this API's origin as authorized. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=

# Admin seed (used by `npm run seed`)
ADMIN_EMAIL=admin@andaryshop.com
ADMIN_PASSWORD=changeme123

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=andary-shop
# Public URL where the bucket/custom domain serves objects from (no trailing slash)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
